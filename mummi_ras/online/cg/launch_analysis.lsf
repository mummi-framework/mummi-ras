#!/bin/bash
#BSUB -nnodes 1
#BSUB -W 1440 
#BSUB -G cancer            
#BSUB -e cga_%J.err             
#BSUB -o cga_%J.out 
#BSUB -J cganalysis                   
#BSUB -q pbatch 

# load mummi_environment
source $HOME/.mummi/config.mummi.sh
source $MUMMI_APP/setup/setup.env.sh

NCORES=40

mpirun -n $NCORES python3 $MUMMI_APP/mummi_ras/online/cg/cg_analysis_executor.py --simname "" \
                                                    --noninteractive \
                                                    --path "" \
                                                    --fstype "mummi" \
                                                    --fbio "mummi" \
                                                    --frameProcessBatchSize 100 \
                                                    --siminputs "" \
                                                    --simbin "" \
                                                    --fcount 0\
                                                    --useGromacs

echo 'Done!'
